# Voice Integrity Verification Framework Environment Configuration
# Problem Statement ID: 26104

# Application Core
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite for local testing or PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./voice_integrity.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_integrity

# Cryptography / Biometric Encryption
# 32-byte url-safe base64 key for Fernet symmetric encryption of voiceprints
FERNET_KEY=U3Zvb1JvYnVzdFNlY3JldEtleUZvclZvaWNlUHJpbnQxMjM0NTY3ODk=

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_WINDOW_SECONDS=3.5
AUDIO_OVERLAP_RATIO=0.5
VAD_AGGRESSIVENESS=2

# ML / Inference Configuration
DEVICE=cpu
USE_GPU=false
# AASIST_MODEL_PATH=/app/models/aasist/weights.pth
# WAVLM_MODEL_PATH=/app/models/wavlm/weights.pth
# ECAPA_MODEL_PATH=/app/models/ecapa/weights.pth

# Risk Engine Thresholds (SIH26104 Spec)
RISK_ROUTINE_THRESHOLD=65.0
RISK_HIGH_VALUE_THRESHOLD=45.0
RISK_PRIVILEGED_THRESHOLD=30.0
SAFETY_FLOOR_MEDIUM_CONFIDENCE=0.90
SAFETY_FLOOR_HIGH_CONFIDENCE=0.97

# Privacy & Retention (DPDP Act 2023)
DATA_RETENTION_DAYS=30
AUTO_DELETE_RAW_AUDIO=true
CONSENT_REQUIRED_FOR_ENROLLMENT=true

# Edge / Offline Mode
OFFLINE_MODE=false
EDGE_QUEUE_DIR=./edge_queue
